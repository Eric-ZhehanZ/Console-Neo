{
  "name": "console-neo",
  "productName": "Console Neo",
  "version": "2.0.0",
  "description": "The next generation of MUN conference softwares",
  "main": "main.js",
  "scripts": {
    "postMacinstall": "electron-builder install-app-deps",
    "postWininstall": "electron-builder install-app-deps --platform=win32",
    "test": "eslint .",
    "electron": "electron",
    "start": "electron .",
    "server": "electron server/main.js",
    "reset": "rm -rf server/backend/storage/*.db server/backend/storage/*.files",
    "clean": "rm -rf Console-Lite-* Console\\ Lite*",
    "pack": "node bin/pack.js",
    "rebuildNative": "node bin/rebuild.js",
    "beforeBuild": "npm i && npm i electron-packager --save-dev && source ./predeploy.sh",
    "build": "npm run buildMac",
    "buildMac": "node -e \"require('electron-packager')({ dir: '.', name: 'Console Neo', platform: 'darwin', arch: 'universal', icon: 'images/icon.icns', out: 'dist', overwrite: true, ignore: [/^\\/dist/], osxUniversal: { x64ArchFiles: '**/*.node' }, extendInfo: { NSLocalNetworkUsageDescription: 'Console Neo discovers nearby sessions on your local network.', NSBonjourServices: ['_console-neo._tcp'] } }).then(p => console.log('PACKAGED:', p))\"",
    "afterBuild": "tar zcf dist/Console-Neo-$(git log -n 1 --pretty=format:'%h').tar.gz dist/"
  },
  "author": "Liu Xiaoyi",
  "contributors": [
    "Pan Ruizhe"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-packager": "^17.1.2",
    "eslint": "^3.3.1",
    "eslint-config-airbnb-base": "^5.0.3",
    "eslint-plugin-import": "^1.14.0",
    "listr": "^0.5.0",
    "ora": "^0.3.0",
    "rxjs": "^5.0.0-beta.11"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "bezier-easing": "^2.1.0",
    "bonjour-service": "^1.4.4",
    "classic-level": "^1.4.1",
    "fstream": "^1.0.11",
    "pdfjs-dist": "^1.10.100",
    "pinyin": "^2.11.2",
    "push.js": "0.0.11",
    "quill": "^1.3.7",
    "rimraf": "^2.6.2",
    "socket.io": "^1.7.4",
    "socket.io-client": "^1.7.4",
    "tar": "^2.2.1",
    "vue": "^1.0.26",
    "vue-animated-list": "^1.0.2",
    "ws": "^8.18.0",
    "y-quill": "^0.1.5",
    "yjs": "^13.6.31"
  }
}
